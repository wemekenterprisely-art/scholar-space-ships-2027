# ScholarSpace-ships — copy to .env for local runs; GitHub uses Actions secrets
# Optional notifications (leave empty = disabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BREVO_API_KEY=
TO_EMAIL=

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Tuning
SCHOLAR_MIN_SCORE=65
SCHOLAR_MAX_AI_JOBS=10
SCHOLAR_BATCH_SIZE=8
SCHOLAR_MAX_AGE_DAYS=60
DASHBOARD_PORT=8000
API_PORT=8001
